# Server
PORT=3000

# Inference backend (choose one)
# Option A: Arcon LoRA (recommended for Arcon V1)
ARCON_INFERENCE_BACKEND=arcon-lora
ARCON_INFERENCE_BASE_URL=http://localhost:8000
ARCON_ADAPTER_NAME=arcon-v1

# Option B: Ollama (fallback)
# ARCON_INFERENCE_BACKEND=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Shared
ARCON_CONTEXT_LIMIT=12

# Optional. Defaults to ./data at the repository root.
ARCON_DATA_DIR=./data
